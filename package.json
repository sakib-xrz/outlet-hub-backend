{
  "name": "outlet-hub-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Secure backend foundation for OutletHub",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "db:migrate:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed:admin": "tsx prisma/seed.ts",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm build",
    "prepare": "husky",
    "verify:sales-concurrency": "tsx scripts/verify-sales-concurrency.ts",
    "verify:reports": "tsx scripts/verify-reports.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,prisma}": "prettier --write"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "openapi-types": "12.1.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-prisma": "5.0.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsc-alias": "1.9.11",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
