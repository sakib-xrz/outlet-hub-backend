NODE_ENV=development
PORT=8000
TRUST_PROXY=0
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT=100kb

DATABASE_URL=postgresql://outlethub:replace-me@db.example.com:5432/outlethub?schema=public&sslmode=require

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_HEALTH_TIMEOUT_MS=2000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=outlet-hub
JWT_AUDIENCE=outlet-hub-web
JWT_ACCESS_TTL_SECONDS=900

REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=outlethub_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=

ALLOWED_ORIGINS=http://localhost:5173

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=debug
LOG_PRETTY=true

SWAGGER_ENABLED=true
